# Copy to .env and fill in. Never commit .env.

# api mode (default provider: Groq)
GROQ_API_KEY=

# Optional backup provider. Free tiers may use your data: public or synthetic data only.
GEMINI_API_KEY=

# mock | api | local (overrides config.yaml; the sidebar can override per session)
FAIRTRACE_MODE=mock

# Set to 1 to save real model outputs to fixtures/recorded/ (copy good ones to fixtures/mock/ for the demo)
FAIRTRACE_RECORD=0
